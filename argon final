// مؤقت النوم الذكي للإذاعة (Option #8)
let sleepTimerInterval = null, sleepRemainingSecs = 0;
function setSleepTimer(mins) {
    if (sleepTimerInterval) clearInterval(sleepTimerInterval);
    const lbl = document.getElementById("sleep-timer-Text");
    if (!mins || mins <= 0) {
        sleepRemainingSecs = 0;
        if (lbl) lbl.textContent = "غير مفعل";
        showToast("تم إلغاء مؤقت النوم", "🌙");
        return;
    }
    sleepRemainingSecs = mins * 60;
    showToast(`سيتم إيقاف الإذاعة تلقائياً بعد ${mins} دقيقة 🌙`, "🌙");
    const updateLbl = () => {
        const m = Math.floor(sleepRemainingSecs / 60);
        const s = sleepRemainingSecs % 60;
        if (lbl) lbl.textContent = `${m}:${String(s).padStart(2,'0')}`;
    };
    updateLbl();
    sleepTimerInterval = setInterval(() => {
        sleepRemainingSecs--;
        updateLbl();
        if (sleepRemainingSecs <= 0) {
            clearInterval(sleepTimerInterval);
            if (!audio.paused) togglePlay();
            if (lbl) lbl.textContent = "توقف تلقائياً";
            showToast("تصبح على خير وطاعة، تم إيقاف الإذاعة تلقائياً 🌙", "🌙");
        }
    }, 1000);
}

function togglePlay() {
    if(!audio.src) {
        if (radioSurahs.length) playRadioSurah(1, radioSurahs[0].name);
        return;
    }
    if(audio.paused) {
        if (aud && !aud.paused) aud.pause();
        audio.play();
        playBtn.innerHTML = svgPause;
        miniPlayBtn.innerText = "⏸";
        document.getElementById('disk').classList.add('playing-now');
    } else {
        audio.pause();
        playBtn.innerHTML = svgPlay;
        miniPlayBtn.innerText = "▶";
        document.getElementById('disk').classList.remove('playing-now');
    }
}

audio.ontimeupdate = function() {
    if(audio.duration && isFinite(audio.duration)) {
        const p = (audio.currentTime / audio.duration) * 100;
        document.getElementById('progress-bar').style.width = p + "%";
        document.getElementById('current-time').innerText = formatTime(audio.currentTime);
        document.getElementById('duration-time').innerText = formatTime(audio.duration);
        document.getElementById('mini-current').innerText = formatTime(audio.currentTime);
        document.getElementById('mini-duration').innerText = formatTime(audio.duration);
    }
};

function setProgress(e) {
    if(!audio.duration || !isFinite(audio.duration)) return;
    const rect = e.currentTarget.getBoundingClientRect();
    const clickX = e.clientX - rect.left;
    const ratio = Math.max(0, Math.min(1, clickX / rect.width));
    audio.currentTime = ratio * audio.duration;
}

function formatTime(secs) {
    let m = Math.floor(secs / 60);
    let s = Math.floor(secs % 60);
    return `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
}

