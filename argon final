function switchAzkar(cat, el) {
    document.querySelectorAll('.azkar-tab').forEach(t => t.classList.remove('active'));
    el.classList.add('active');
    
    const list = document.getElementById('azkarList');
    currentAzkar = {}; 
    
    list.innerHTML = azkarData[cat].map((z, idx) => {
        currentAzkar[idx] = 0; 
        return `
        <div class="azkar-item" id="zi-${idx}" onclick="countZekr(${idx}, ${z.count}, this)">
            <div class="azkar-text">${z.text}</div>
            <div class="azkar-source">📖 ${z.source}</div>
            <div class="azkar-footer">
                <span class="azkar-count"><span id="zc-${idx}">0</span> / ${z.count}</span>
                <div class="azkar-actions">
                    <button class="azkar-reset-btn" onclick="resetZekr(event, ${idx}, ${z.count})">🔄</button>
                    <button class="azkar-btn" id="zb-${idx}">اضغط للذكر</button>
                </div>
            </div>
            <div class="azkar-progress">
                <div class="azkar-progress-bar" id="zp-${idx}"></div>
            </div>
        </div>`;
    }).join('');
}

function countZekr(i, max, card) {
    if (currentAzkar[i] >= max) return; 
    currentAzkar[i]++;
    document.getElementById(`zc-${i}`).innerText = currentAzkar[i];
    document.getElementById(`zp-${i}`).style.width = (currentAzkar[i] / max * 100) + '%';
    if (navigator.vibrate) navigator.vibrate(20);
    if (currentAzkar[i] === max) {
        document.getElementById(`zb-${i}`).classList.add('done');
        document.getElementById(`zb-${i}`).innerText = '✓ تم الفراغ';
        card.style.opacity = '.6';
        worshipState.azkarDone = true;
        safeSetStorage('islamy_worship_v1', worshipState);
    }
}

function resetZekr(event, i, max) {
    event.stopPropagation(); 
    currentAzkar[i] = 0; 
    document.getElementById(`zc-${i}`).innerText = 0;
    document.getElementById(`zp-${i}`).style.width = '0%';
    const btn = document.getElementById(`zb-${i}`);
    btn.classList.remove('done');
    btn.innerText = 'اضغط للذكر';
    document.getElementById(`zi-${i}`).style.opacity = '1';
    if (navigator.vibrate) navigator.vibrate([30, 30]);
}

