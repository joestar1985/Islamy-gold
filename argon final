function playBeadClickSound(isMilestone = false) {
    if (!sebhaSoundEnabled) return;
    try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = isMilestone ? "triangle" : "sine";
        osc.frequency.setValueAtTime(isMilestone ? 660 : 420, ctx.currentTime);
        gain.gain.setValueAtTime(0.12, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + (isMilestone ? 0.25 : 0.06));
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + (isMilestone ? 0.26 : 0.07));
    } catch (e) {}
}

