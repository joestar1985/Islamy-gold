// دعم تقليب صفحات المصحف بالسحب باللمس (Touch Swipe Gesture)
(function initMushafSwipe() {
    let touchStartX = 0;
    document.addEventListener("DOMContentLoaded", () => {
        const stage = document.getElementById("mushafStage");
        if (!stage) return;
        stage.addEventListener("touchstart", e => {
            touchStartX = e.changedTouches[0].screenX;
        }, {passive: true});
        stage.addEventListener("touchend", e => {
            const diff = e.changedTouches[0].screenX - touchStartX;
            if (Math.abs(diff) > 45) {
                // في العربية، السحب لليمين يقلب للصفحة التالية، ولليسار للصفحة السابقة
                if (diff > 0) flipMushafPage(1);
                else flipMushafPage(-1);
            }
        }, {passive: true});
    });
})();

