<!DOCTYPE html>
<html lang="ar">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Islamy Gold | المطور يوسف</title>

<link href="https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Noto+Sans+Arabic:wght@400;600;700;900&display=swap" rel="stylesheet">

<style>
/* --- ألوان وتأثيرات الهوية الفاخرة --- */
:root {
    --accent: #e5c158; 
    --accent-dark: #b8860b;
    --accent-glow: rgba(229, 193, 88, 0.35);
    --bg-dark: #070b14;
    --text-main: #f1f5f9;
    --danger: #ff5252;
    --success: #2ed573;
    
    /* زجاج المصحف والإذاعة وباقي الكروت */
    --glass-bg: rgba(15, 23, 42, 0.45);
    --glass-bg-hover: rgba(30, 41, 59, 0.65);
    --glass-border: rgba(255, 255, 255, 0.08);
    --gold-glass-border: rgba(229, 193, 88, 0.25);
    --gold-glass-glow: rgba(229, 193, 88, 0.05);
    
    --gold: #e5c158; 
    --gold2: #b8860b; 
    --bg-quran: transparent;
    --card-quran: rgba(15, 23, 42, 0.5); 
    --line: rgba(229, 193, 88, 0.2);
    --txt-quran: #f8fafc; 
    --muted: #94a3b8;
    --quran-font-size: 24px;
}

/* ثيمات إضافية فاخرة (Option #20) */
body.theme-emerald {
    --accent: #10b981;
    --accent-dark: #047857;
    --accent-glow: rgba(16, 185, 129, 0.35);
    --gold-glass-border: rgba(16, 185, 129, 0.28);
    --gold: #10b981;
    --gold2: #047857;
    --line: rgba(16, 185, 129, 0.2);
}
body.theme-sapphire {
    --accent: #38bdf8;
    --accent-dark: #0284c7;
    --accent-glow: rgba(56, 189, 248, 0.35);
    --gold-glass-border: rgba(56, 189, 248, 0.28);
    --gold: #38bdf8;
    --gold2: #0284c7;
    --line: rgba(56, 189, 248, 0.2);
}
body.theme-amber {
    --accent: #f59e0b;
    --accent-dark: #b45309;
    --accent-glow: rgba(245, 158, 11, 0.35);
    --gold-glass-border: rgba(245, 158, 11, 0.28);
    --gold: #f59e0b;
    --gold2: #b45309;
    --line: rgba(245, 158, 11, 0.2);
}
body.theme-amethyst {
    --accent: #c084fc;
    --accent-dark: #7e22ce;
    --accent-glow: rgba(192, 132, 252, 0.35);
    --gold-glass-border: rgba(192, 132, 252, 0.28);
    --gold: #c084fc;
    --gold2: #7e22ce;
    --line: rgba(192, 132, 252, 0.2);
}

*{
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), 
                background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
}

body{
    margin: 0; font-family: 'Noto Sans Arabic', sans-serif; direction: rtl;
    background: #060913;
    background-image: 
        radial-gradient(circle at 50% 0%, rgba(28, 45, 87, 0.6) 0%, transparent 50%),
        radial-gradient(circle at 0% 100%, rgba(229, 193, 88, 0.08) 0%, transparent 40%);
    background-attachment: fixed;
    color: var(--text-main); min-height: 100vh;
    overflow-x: hidden;
}

#app{ max-width: 520px; margin: auto; position: relative; padding-bottom: 150px; padding-top: 10px;}

/* --- شاشة التحميل الذكية --- */
#splash {
    position: fixed; inset: 0; background: var(--bg-dark);
    display: flex; flex-direction: column; justify-content: center; align-items: center;
    z-index: 9999; animation: fadeOut 0.6s cubic-bezier(0.25, 1, 0.5, 1) 2.2s forwards;
}
.splash-logo {
    font-size: 90px; filter: drop-shadow(0 0 35px var(--accent-glow));
    animation: floatingPulse 2s ease-in-out infinite;
}
@keyframes floatingPulse {
    0% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-12px) scale(1.06); }
    100% { transform: translateY(0) scale(1); }
}
@keyframes fadeOut{ to{opacity: 0; visibility: hidden; pointer-events: none;} }

/* --- شريط الإشعارات الزجاجي الفاخر (Toast Notification) --- */
#luxury-toast {
    position: fixed; top: 20px; left: 50%; transform: translateX(-50%) translateY(-120px);
    background: rgba(15, 23, 42, 0.95); backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1.5px solid var(--accent); border-radius: 20px;
    padding: 14px 22px; color: #fff; font-weight: 700; font-size: 14px;
    z-index: 20000; box-shadow: 0 15px 40px rgba(0,0,0,0.6), 0 0 25px var(--accent-glow);
    display: flex; align-items: center; gap: 10px; max-width: 90%; text-align: center;
    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s ease;
    opacity: 0; pointer-events: none;
}
#luxury-toast.show {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
}

/* --- الهيدر الزجاجي الأنيق --- */
.hero-header {
    text-align: center; padding: 36px 20px 28px;
    background: rgba(13, 22, 44, 0.5);
    backdrop-filter: blur(25px) saturate(160%);
    -webkit-backdrop-filter: blur(25px) saturate(160%);
    border: 1px solid var(--gold-glass-border);
    border-radius: 32px; margin: 15px 15px 22px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.1);
    position: relative; overflow: hidden;
    animation: fadeInDown 0.8s cubic-bezier(0.25, 1, 0.5, 1);
}
.hero-top-actions {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 10px;
}
.theme-pill-btn {
    width: auto; padding: 7px 14px; font-size: 12px; border-radius: 20px;
    background: rgba(255,255,255,0.06); border: 1px solid var(--gold-glass-border);
    color: var(--accent); box-shadow: none; font-weight: 700;
}
.hero-logo {
    width: 85px; height: 85px; background: rgba(255,255,255,0.03);
    border: 1.5px solid var(--accent); border-radius: 50%;
    display: flex; justify-content: center; align-items: center;
    font-size: 40px; margin: 0 auto 15px;
    box-shadow: 0 0 30px var(--accent-glow), inset 0 0 15px rgba(229,193,88,0.2);
    animation: floatingPulse 3.5s ease-in-out infinite;
}
.hero-title { 
    font-size: 28px; font-weight: 900; color: #fff; 
    background: linear-gradient(135deg, #fff 30%, var(--accent));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    margin: 0 0 8px; text-shadow: 0 0 30px var(--accent-glow);
}
.hero-subtitle { 
    font-family: 'Amiri Quran', serif; font-size: 20px; color: #e2e8f0; opacity: 0.95; margin: 0;
}

/* شريط الثيمات السريع */
.theme-selector-bar {
    display: flex; justify-content: center; gap: 10px; margin-top: 16px; flex-wrap: wrap;
}
.theme-dot {
    width: 28px; height: 28px; border-radius: 50%; cursor: pointer;
    border: 2px solid rgba(255,255,255,0.25); transition: transform 0.2s, border-color 0.2s;
    position: relative;
}
.theme-dot.active {
    transform: scale(1.2); border-color: #fff; box-shadow: 0 0 12px var(--accent);
}

/* --- تصميم بطاقة الآية القرآنية --- */
.quran-verse-card {
    text-align: center;
    background: rgba(229, 193, 88, 0.04);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--gold-glass-border);
    border-radius: 24px; padding: 25px 20px; margin: 0 15px 20px;
    box-shadow: 0 15px 35px rgba(0,0,0,0.2);
    animation: fadeInUp 0.8s ease;
}
.quran-verse-text {
    font-family: 'Amiri Quran', serif; font-size: 23px; color: #fff; line-height: 1.8;
    text-shadow: 0 2px 10px rgba(0,0,0,0.5);
}

/* --- شبكة القائمة الرئيسية الزجاجية --- */
.home-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; padding: 0 15px; }
.home-card {
    background: var(--glass-bg);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid var(--glass-border);
    border-radius: 24px; padding: 22px 14px; text-align: center;
    cursor: pointer; box-shadow: 0 10px 30px rgba(0,0,0,0.25);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    position: relative; overflow: hidden;
}
.home-card:hover, .home-card:active {
    transform: translateY(-5px);
    background: var(--glass-bg-hover);
    border-color: var(--gold-glass-border);
    box-shadow: 0 15px 35px rgba(0,0,0,0.35), 0 0 20px rgba(229,193,88,0.15);
}
.home-card-icon { font-size: 40px; margin-bottom: 10px; filter: drop-shadow(0 4px 10px rgba(0,0,0,0.3)); }
.home-card-title { font-size: 15px; font-weight: 700; color: #fff; margin: 0; }
.home-card-sub { font-size: 11px; color: var(--muted); margin-top: 4px; font-weight: 600; }
.home-card.featured { 
    grid-column: span 2; flex-direction: row; gap: 20px; padding: 22px 25px; 
    background: linear-gradient(135deg, rgba(229,193,88,0.12), rgba(15,23,42,0.4)); 
    border-color: var(--gold-glass-border);
}
.home-card.featured .home-card-icon { font-size: 46px; margin-bottom: 0; }
.home-card.featured .home-card-title { font-size: 20px; color: var(--accent); }

/* --- استايل الكروت الموحد الزجاجي الفخم --- */
.card {
    background: var(--glass-bg); 
    backdrop-filter: blur(25px) saturate(180%);
    -webkit-backdrop-filter: blur(25px) saturate(180%);
    border: 1px solid var(--glass-border);
    border-radius: 28px; padding: 25px 22px; margin: 20px 15px; 
    box-shadow: 0 20px 45px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255,255,255,0.05);
}

h2 { color: var(--accent); font-weight: 700; margin-top: 0; font-size: 20px; display: flex; align-items: center; gap: 12px; justify-content: center; margin-bottom: 20px;}

/* --- نظام الأزرار الزجاجية الحيوية الجديد --- */
button {
    width: 100%; padding: 15px; border: none; border-radius: 18px;
    background: linear-gradient(135deg, var(--accent), var(--accent-dark));
    color: #060913; font-size: 15px; font-weight: 700; cursor: pointer;
    box-shadow: 0 10px 25px rgba(229,193,88,0.25);
    display: flex; justify-content: center; align-items: center; gap: 8px;
    font-family: inherit;
}
button:active { transform: scale(0.97); opacity: 0.9; }

.btn-secondary {
    background: rgba(255,255,255,0.04); 
    border: 1px solid var(--glass-border);
    color: #e2e8f0; margin-top: 10px; box-shadow: none;
}
.btn-secondary:hover { background: rgba(255,255,255,0.08); border-color: var(--gold-glass-border); color: var(--accent); }

/* --- كروت الصلوات والقبلة الفاخرة --- */
.prayers-premium-card {
    border-color: var(--gold-glass-border);
    background: linear-gradient(180deg, rgba(15,23,42,0.5), rgba(7,11,20,0.6));
}
.prayer-next-zone {
    background: linear-gradient(135deg, rgba(229,193,88,0.1), rgba(255,255,255,0.02));
    border: 1px solid var(--gold-glass-border);
    border-radius: 24px; padding: 20px; margin-bottom: 20px;
    display: flex; align-items: center; justify-content: space-between;
}
.prayer-next-info { text-align: right; }
.prayer-next-title { font-size: 13px; color: var(--muted); font-weight: 600; display: block; margin-bottom: 4px; }
.prayer-next-name { font-size: 24px; font-weight: 900; color: #fff; text-shadow: 0 0 15px var(--accent-glow); }
.prayer-countdown-circle {
    width: 74px; height: 74px; border-radius: 50%;
    border: 3px dashed var(--accent); display: flex; flex-direction: column;
    justify-content: center; align-items: center; font-weight: 700;
    box-shadow: 0 0 15px var(--accent-glow);
}
.prayer-countdown-circle span { font-size: 15px; color: var(--accent); }
.prayer-countdown-circle small { font-size: 9px; color: var(--muted); }

.prayer-tracker-zone {
    background: rgba(0,0,0,0.25); border: 1px solid var(--glass-border);
    border-radius: 20px; padding: 16px; margin-bottom: 22px;
    display: flex; align-items: center; justify-content: space-between; gap: 10px;
}
.prayer-tracker-text { font-size: 14px; font-weight: 600; color: #cbd5e1; }
.prayer-tracker-bar-bg { width: 50%; height: 10px; background: rgba(255,255,255,0.06); border-radius: 10px; overflow: hidden; position: relative; }
.prayer-tracker-bar-fill { height: 100%; width: 0%; background: linear-gradient(90deg, var(--accent-dark), var(--accent)); border-radius: 10px; box-shadow: 0 0 15px var(--accent); }

.prayer-row-item {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 18px; background: rgba(255,255,255,0.02);
    border-radius: 20px; margin-bottom: 10px; border: 1px solid var(--glass-border);
}
.prayer-row-item.current-active {
    background: rgba(229, 193, 88, 0.08); border-color: var(--gold-glass-border);
    box-shadow: inset 0 0 15px rgba(229,193,88,0.05);
}
.prayer-row-right { display: flex; align-items: center; gap: 12px; }
.prayer-row-name { font-size: 16px; font-weight: 700; color: #fff; }
.prayer-row-item.current-active .prayer-row-name { color: var(--accent); }
.prayer-row-time { font-size: 18px; font-weight: 700; color: #cbd5e1; }
.prayer-row-item.current-active .prayer-row-time { color: #fff; }

.prayer-check-btn {
    width: 32px; height: 32px; border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.2); background: transparent;
    cursor: pointer; display: flex; justify-content: center; align-items: center;
    color: transparent; font-size: 14px; font-weight: 900; padding: 0;
}
.prayer-check-btn.done {
    background: var(--accent); border-color: var(--accent); color: #060913;
    box-shadow: 0 0 15px var(--accent-glow);
}

.hijri-card-box {
    background: rgba(229, 193, 88, 0.04); border: 1px dashed var(--gold-glass-border);
    border-radius: 18px; padding: 14px; text-align: center; margin-bottom: 15px;
}

/* أوقات النوافل والثلث الأخير (Option #16) */
.nawafil-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 15px 0;
}
.nawafil-box {
    background: rgba(255,255,255,0.02); border: 1px solid var(--glass-border);
    border-radius: 16px; padding: 10px 6px; text-align: center;
}
.nawafil-box small { display: block; font-size: 11px; color: var(--muted); margin-bottom: 4px; }
.nawafil-box strong { font-size: 14px; color: var(--accent); }

/* البوصلة الفاخرة */
.premium-compass-btn {
    background: rgba(255,255,255,0.03); border: 1px solid var(--gold-glass-border); color: var(--accent);
    box-shadow: none; font-weight: 700; border-radius: 16px; margin-top: 15px;
}
.premium-compass-btn:hover { background: rgba(229,193,88,0.1); }
.premium-compass-zone {
    position: relative; width: 180px; height: 180px; margin: 20px auto;
    display: flex; justify-content: center; align-items: center;
}
.premium-compass-glow {
    position: absolute; inset: -10px; border-radius: 50%;
    background: radial-gradient(circle, rgba(229, 193, 88, 0.1) 0%, transparent 70%);
}

/* --- مشغل الإذاعة والتأثيرات الصوتية الحركية --- */
.radio-premium-card { border-color: var(--gold-glass-border); }
.radio-visualizer-zone {
    position: relative; width: 190px; height: 190px; margin: 15px auto 25px;
    display: flex; justify-content: center; align-items: center;
}
.glow-ring-outer {
    position: absolute; inset: -10px; border-radius: 50%;
    border: 2px dashed rgba(255,255,255,0.1); animation: spinRing 30s linear infinite;
}
.glow-ring-inner {
    position: absolute; inset: -2px; border-radius: 50%;
    border: 1px solid var(--glass-border); background: rgba(255,255,255,0.01);
}
.player-disk {
    width: 150px; height: 150px; background: radial-gradient(circle, #131c31 30%, #080d1a 100%);
    border: 2.5px solid var(--accent); border-radius: 50%; margin: 0 auto;
    display: flex; justify-content: center; align-items: center; font-size: 55px;
    box-shadow: 0 15px 35px rgba(0,0,0,0.5), inset 0 0 20px rgba(0,0,0,0.6);
    position: relative; z-index: 3;
}
.playing-now { 
    animation: rotateDisk 12s linear infinite !important; 
    box-shadow: 0 0 40px var(--accent-glow), inset 0 0 25px rgba(229,193,88,0.2) !important;
    border-color: #fff !important;
}
@keyframes spinRing { to { transform: rotate(360deg); } }
@keyframes rotateDisk { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

#playing-surah-title {
    font-size: 20px; font-weight: 700; color: #fff; margin: 10px 0 20px; text-shadow: 0 0 10px rgba(255,255,255,0.2);
}

.radio-control-panel {
    background: rgba(15, 23, 42, 0.6); border: 1px solid var(--gold-glass-border);
    border-radius: 24px; padding: 25px 20px; margin-bottom: 25px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255,255,255,0.05);
}
.progress-container { 
    width: 100%; height: 8px; background: rgba(0,0,0,0.5); 
    border: 1px solid rgba(255,255,255,0.05); border-radius: 10px; 
    margin: 18px 0; cursor: pointer; display: flex; align-items: center; direction: ltr;
}
.progress-bar { 
    height: 100%; background: linear-gradient(90deg, var(--accent-dark), var(--accent)); 
    width: 0%; border-radius: 10px; box-shadow: 0 0 15px var(--accent-glow); position: relative;
}
.progress-bar::after { 
    content: ''; position: absolute; right: -6px; top: 50%; transform: translateY(-50%); 
    width: 14px; height: 14px; background: #fff; border-radius: 50%; 
    box-shadow: 0 0 10px rgba(0,0,0,0.6); transition: transform 0.1s;
}
.progress-container:active .progress-bar::after { transform: translateY(-50%) scale(1.3); }
.time-box { display: flex; justify-content: space-between; font-size: 14px; color: #cbd5e1; font-weight: 700; font-family: 'Noto Sans Arabic', sans-serif;}

#main-play-btn {
    width: 75px; height: 75px; border-radius: 50%; display: flex; justify-content: center; align-items: center; margin: 15px auto 5px;
    background: linear-gradient(135deg, var(--accent), var(--accent-dark)); color: #060913;
    box-shadow: 0 10px 25px var(--accent-glow); border: none; cursor: pointer; transition: all 0.3s ease;
}
#main-play-btn:active { transform: scale(0.92); }

/* تبويبات القراء الاحترافية */
.radio-reciters-wrap { text-align: right; margin-bottom: 15px; }
.radio-reciters-title { font-size: 13px; color: var(--muted); font-weight: 700; margin-bottom: 10px; display: block; }
.radio-reciters-tabs { display: flex; gap: 10px; overflow-x: auto; scrollbar-width: none; direction: rtl; padding-bottom: 5px; }
.radio-reciters-tabs::-webkit-scrollbar { display: none; }
.radio-reciter-tab { 
    padding: 10px 18px; background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); 
    border-radius: 16px; font-size: 13px; font-weight: 700; cursor: pointer; white-space: nowrap; color: #e2e8f0; transition: all 0.3s;
}
.radio-reciter-tab.active { background: var(--accent); color: #060913; border-color: transparent; box-shadow: 0 8px 20px var(--accent-glow); }

.radio-search, #quran-wrapper .search { position: relative; margin: 20px 0 15px; }
.radio-search input, #quran-wrapper .search input, .glass-input { 
    width: 100%; padding: 15px 45px 15px 16px; border-radius: 18px; 
    border: 1px solid var(--glass-border); background: rgba(0,0,0,0.3); 
    color: #fff; font: inherit; outline: none; text-align: right;
}
.glass-input { padding: 14px 16px; }
.radio-search input:focus, #quran-wrapper .search input:focus, .glass-input:focus { border-color: var(--accent); background: rgba(0,0,0,0.4); box-shadow: 0 0 15px rgba(229,193,88,0.1); }
.radio-search .ic, #quran-wrapper .search .ic { position: absolute; right: 18px; top: 50%; transform: translateY(-50%); color: var(--muted); }

.surah-item { 
    display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; 
    background: rgba(255,255,255,0.02); border: 1px solid var(--glass-border); border-radius: 16px; 
    cursor: pointer; margin-bottom: 8px;
}
.surah-item:hover { background: rgba(255,255,255,0.05); border-color: var(--gold-glass-border); }
.surah-item.playing-active { background: rgba(229,193,88,0.1); border-color: var(--accent); color: var(--accent); font-weight: 700; }

/* --- البار السفلي الحركي المطور --- */
.nav {
    position: fixed; bottom: 16px; left: 50%; transform: translateX(-50%);
    width: 95%; max-width: 490px; height: 74px;
    background: rgba(13, 22, 44, 0.78); backdrop-filter: blur(30px) saturate(170%);
    -webkit-backdrop-filter: blur(30px) saturate(170%);
    border-radius: 26px; display: flex; justify-content: space-around; align-items: center;
    border: 1px solid var(--glass-border); z-index: 1000;
    box-shadow: 0 15px 40px rgba(0,0,0,0.55), inset 0 1px 0 rgba(255,255,255,0.1);
    padding: 0 4px;
}
.nav-item { text-align: center; opacity: .5; cursor: pointer; color: #fff; flex: 1; padding: 4px 0; }
.active-nav { opacity: 1; color: var(--accent); transform: translateY(-4px); }
.nav-icon { font-size: 20px; filter: drop-shadow(0 2px 5px rgba(0,0,0,0.3)); }
.nav-item span { font-size: 9.5px; display: block; font-weight: 700; margin-top: 3px; white-space: nowrap; }

/* البار المصغر للمشغل السريع */
#miniPlayer {
    position: fixed; bottom: 100px; left: 50%; transform: translateX(-50%);
    width: 92%; max-width: 460px; background: rgba(15, 23, 42, 0.9);
    backdrop-filter: blur(25px); -webkit-backdrop-filter: blur(25px);
    border: 1px solid var(--gold-glass-border);
    border-radius: 20px; padding: 12px 18px; display: none; 
    align-items: center; justify-content: space-between; z-index: 999;
    box-shadow: 0 10px 35px rgba(0,0,0,0.5);
}
.mini-details { display: flex; flex-direction: column; flex: 1; margin-right: 15px; text-align: right;}
.mini-title { font-size: 13px; font-weight: 700; color: var(--accent); }
.mini-time { font-size: 11px; color: var(--muted); margin-top: 2px; }
.mini-play-btn { font-size: 24px; cursor: pointer; color: var(--accent); padding: 4px 10px; }

/* --- تصميم السبحة الزجاجية المتوهجة --- */
.sebha-premium-card { border-color: var(--gold-glass-border); }
.sebha-circle { 
    width: 210px; height: 210px; margin: 25px auto; 
    background: radial-gradient(circle, rgba(255,255,255,0.03) 0%, rgba(0,0,0,0.25) 100%); 
    border: 4px double var(--gold-glass-border); border-radius: 50%; 
    display: flex; flex-direction: column; justify-content: center; align-items: center; 
    box-shadow: 0 20px 40px rgba(0,0,0,0.4), inset 0 0 20px rgba(255,255,255,0.05); 
    cursor: pointer; user-select: none; position: relative;
}
.sebha-circle:active { 
    transform: scale(0.94); border-color: var(--accent); 
    box-shadow: 0 0 35px var(--accent-glow), inset 0 0 25px rgba(229,193,88,0.18);
}
#sebha-count { 
    font-size: 62px; font-weight: 900; color: #fff;
    text-shadow: 0 0 20px var(--accent-glow);
}
.sebha-label { font-size: 14px; font-weight: 600; color: var(--muted); margin-top: -2px; }

/* --- ألسنة وقوائم الأذكار الحديثة --- */
.azkar-tabs { display: flex; gap: 10px; overflow-x: auto; padding: 5px 2px 15px; scrollbar-width: none; direction: rtl;}
.azkar-tabs::-webkit-scrollbar { display: none; }
.azkar-tab { 
    padding: 10px 20px; background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); 
    border-radius: 14px; font-size: 14px; font-weight: 700; cursor: pointer; white-space: nowrap; color: #cbd5e1; 
}
.azkar-tab.active { background: var(--accent); color: #060913; border-color: transparent; box-shadow: 0 8px 20px var(--accent-glow); }

.azkar-item { 
    background: rgba(255,255,255,0.01); border: 1px solid var(--glass-border); 
    border-radius: 22px; padding: 22px; margin-bottom: 15px; position: relative; overflow: hidden; cursor: pointer;
}
.azkar-item::before { content: ""; position: absolute; top: 0; right: 0; width: 4px; height: 100%; background: var(--accent); }
.azkar-item:active { transform: scale(0.99); background: rgba(255,255,255,0.03); }
.azkar-text { font-family: 'Amiri Quran', serif; font-size: 22px; line-height: 1.9; color: #fff; margin-bottom: 15px; text-align: justify; }
.azkar-source { font-size: 12px; color: var(--muted); margin-bottom: 12px; }
.azkar-footer { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
.azkar-count { background: rgba(229,193,88,0.1); color: var(--accent); padding: 6px 14px; border-radius: 12px; font-weight: 700; font-size: 14px; }
.azkar-actions { display: flex; gap: 10px; }
.azkar-btn { width: auto; padding: 10px 20px; font-size: 13px; border-radius: 12px; background: rgba(255,255,255,0.05); color: #fff; font-weight: 700; border: 1px solid var(--glass-border); box-shadow: none; }
.azkar-btn.done { background: rgba(46, 213, 115, 0.15); color: #2ed573; border-color: rgba(46, 213, 115, 0.3); }
.azkar-reset-btn { width: auto; background: rgba(255, 82, 82, 0.1); border: 1px solid rgba(255, 82, 82, 0.2); color: var(--danger); padding: 10px 14px; border-radius: 12px; cursor: pointer; font-size: 14px; box-shadow: none;}
.azkar-progress { height: 4px; background: rgba(255,255,255,0.06); border-radius: 4px; margin-top: 15px; overflow: hidden; }
.azkar-progress-bar { height: 100%; width: 0%; background: var(--accent); }

/* --- صفحات التطبيق والمصحف --- */
#quran-wrapper { background: transparent; color: var(--txt-quran); overflow: hidden; }
#quran-wrapper .head { display: flex; align-items: center; gap: 15px; justify-content: center; margin-bottom: 20px; }
#quran-wrapper .logo { width: 60px; height: 60px; border-radius: 50%; display: grid; place-items: center; font-size: 30px; background: rgba(229,193,88,0.1); border: 1px solid var(--gold-glass-border); }
#quran-wrapper h1 { margin: 0; font-size: 26px; font-weight: 900; color: #fff; }
#quran-wrapper .sub { font-size: 13px; color: var(--muted); text-align: center; margin-top: 2px; }
#quran-wrapper .surah { display: grid; grid-template-columns: auto 1fr auto; gap: 15px; align-items: center; padding: 16px; border-radius: 18px; background: rgba(255,255,255,0.02); border: 1px solid var(--glass-border); cursor: pointer; margin-bottom: 10px; text-align: right;}
#quran-wrapper .surah:hover { background: var(--glass-bg-hover); border-color: var(--gold-glass-border); }
#quran-wrapper .num { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; color: var(--accent); font-weight: 700; background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); }
#quran-wrapper .name { font-weight: 700; font-size: 18px; color: #fff; margin: 0; }
#quran-wrapper .meta { font-size: 13px; color: var(--muted); margin-top: 2px; }
#quran-wrapper .badge { font-size: 12px; padding: 5px 12px; border-radius: 20px; border: 1px solid var(--glass-border); color: var(--accent); background: rgba(229,193,88,0.05); }

#quran-wrapper .r-top { position: sticky; top: 0; z-index: 5; display: flex; align-items: center; justify-content: space-between; padding: 12px 5px; background: rgba(7,11,20,0.9); backdrop-filter: blur(20px); border-bottom: 1px solid var(--glass-border); margin-bottom: 15px; border-radius: 14px;}
#quran-wrapper .back { width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; background: rgba(255,255,255,0.05); color: var(--accent); cursor: pointer; font-weight: 700; }
#quran-wrapper .rtitle { font-weight: 700; color: var(--accent); font-size: 20px; text-align: center; }
#quran-wrapper .rinfo { font-size: 12px; color: var(--muted); text-align: center; }
#quran-wrapper .basmala { font-family: "Amiri Quran", serif; font-size: 28px; text-align: center; color: var(--accent); margin: 18px 0; text-shadow: 0 0 15px var(--accent-glow); }
#quran-wrapper .quran { font-family: "Amiri Quran", serif; font-size: var(--quran-font-size); line-height: 2.25; text-align: justify; color: #fff; padding: 10px 5px 30px; border-radius: 18px; transition: background 0.3s, color 0.3s; }
#quran-wrapper .quran.paper-cream { background: #fdf6e3; color: #2c1e14; padding: 18px 14px; border: 2px solid #d4af37; box-shadow: inset 0 0 30px rgba(184, 134, 11, 0.15); }
#quran-wrapper .quran.paper-cream .anum { color: #8b6508; }
#quran-wrapper .quran.paper-sepia { background: #1e1810; color: #e8dcc5; padding: 18px 14px; border: 1px solid rgba(229,193,88,0.35); }

#quran-wrapper .ayah { padding: 4px 6px; border-radius: 8px; cursor: pointer; display: inline; }
#quran-wrapper .ayah:hover { background: rgba(229,193,88,0.15); }
#quran-wrapper .ayah.playing { background: rgba(229,193,88,0.28); color: var(--accent); box-shadow: 0 0 12px rgba(229,193,88,0.2); }
#quran-wrapper .quran.paper-cream .ayah.playing { background: rgba(184,134,11,0.22); color: #78350f; }
#quran-wrapper .anum { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; margin: 0 4px; font: 700 12px "Noto Sans Arabic"; color: var(--accent); position: relative; z-index: 1; }
#quran-wrapper .anum::before { content: ""; position: absolute; inset: 0; background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><path d="M50 8 L64 36 L94 50 L64 64 L50 92 L36 64 L6 50 L36 36 Z" fill="none" stroke="%23e5c158" stroke-width="5"/></svg>') center/contain no-repeat; z-index: -1; opacity: 0.7; }
/* تمييز العلامة المرجعية */
#quran-wrapper .ayah.bookmarked { border-bottom: 2px dashed var(--accent); background: rgba(229,193,88,0.12); }

/* =========================================================
   --- تصميم المصحف الورقي وتقليب الصفحات ثلاثي الأبعاد (3D Mushaf Page Flip) ---
   ========================================================= */
.quran-mode-switcher {
    display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px;
    background: rgba(0,0,0,0.35); padding: 6px; border-radius: 18px;
    border: 1px solid var(--gold-glass-border); margin-bottom: 18px;
}
.q-mode-btn {
    padding: 10px 8px; border-radius: 13px; font-size: 13px; font-weight: 700;
    background: transparent; color: var(--muted); border: none; box-shadow: none;
}
.q-mode-btn.active {
    background: linear-gradient(135deg, var(--accent), var(--accent-dark));
    color: #060913; box-shadow: 0 4px 15px var(--accent-glow);
}

.mushaf-book-stage {
    perspective: 1600px;
    position: relative;
    margin: 10px 0 15px;
    user-select: none;
}
.mushaf-page-frame {
    background: linear-gradient(145deg, rgba(18, 28, 52, 0.92), rgba(9, 14, 28, 0.96));
    border: 2px solid var(--gold-glass-border);
    border-radius: 22px;
    padding: 18px 16px 22px;
    min-height: 490px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.55), inset 0 0 0 4px rgba(229,193,88,0.08);
    position: relative;
    transform-origin: left center;
    transform-style: preserve-3d;
    backface-visibility: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}
.mushaf-page-frame.paper-cream {
    background: linear-gradient(145deg, #fffaf0, #f5ead2);
    color: #261a10;
    border-color: #c59b27;
    box-shadow: 0 20px 50px rgba(0,0,0,0.45), inset 0 0 0 4px rgba(184,134,11,0.18);
}
.mushaf-page-frame.paper-cream .mushaf-page-content { color: #23170d; }
.mushaf-page-frame.paper-cream .mushaf-header-bar,
.mushaf-page-frame.paper-cream .mushaf-footer-bar { color: #785208; border-color: rgba(184,134,11,0.3); }
.mushaf-page-frame.paper-sepia {
    background: linear-gradient(145deg, #211a12, #15100b);
    color: #ecdcc2;
    border-color: rgba(229,193,88,0.4);
}
/* ظل طي الصفحة في المنتصف */
.mushaf-page-frame::after {
    content: "";
    position: absolute; top: 0; bottom: 0; left: 0; width: 28px;
    background: linear-gradient(90deg, rgba(0,0,0,0.38), transparent);
    border-radius: 20px 0 0 20px;
    pointer-events: none;
}

/* حركات تقليب الصفحة ثلاثية الأبعاد */
@keyframes flipNextPage3D {
    0% { transform: rotateY(0deg) scale(1); filter: brightness(1); }
    45% { transform: rotateY(88deg) scale(0.96) skewY(-2deg); filter: brightness(0.55); box-shadow: -30px 10px 50px rgba(0,0,0,0.8); }
    55% { transform: rotateY(-88deg) scale(0.96) skewY(2deg); filter: brightness(0.55); }
    100% { transform: rotateY(0deg) scale(1); filter: brightness(1); }
}
@keyframes flipPrevPage3D {
    0% { transform: rotateY(0deg) scale(1); filter: brightness(1); }
    45% { transform: rotateY(-88deg) scale(0.96) skewY(2deg); filter: brightness(0.55); box-shadow: 30px 10px 50px rgba(0,0,0,0.8); }
    55% { transform: rotateY(88deg) scale(0.96) skewY(-2deg); filter: brightness(0.55); }
    100% { transform: rotateY(0deg) scale(1); filter: brightness(1); }
}
.mushaf-page-frame.flipping-next {
    animation: flipNextPage3D 0.68s cubic-bezier(0.45, 0.05, 0.55, 0.95);
}
.mushaf-page-frame.flipping-prev {
    animation: flipPrevPage3D 0.68s cubic-bezier(0.45, 0.05, 0.55, 0.95);
}

.mushaf-header-bar {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: 10px; margin-bottom: 12px;
    border-bottom: 1.5px double var(--gold-glass-border);
    font-size: 13px; font-weight: 700; color: var(--accent);
}
.mushaf-surah-banner {
    background: linear-gradient(90deg, rgba(229,193,88,0.06), rgba(229,193,88,0.22), rgba(229,193,88,0.06));
    border: 1.5px solid var(--gold-glass-border);
    border-radius: 14px; padding: 8px 14px; margin: 10px 0;
    text-align: center; font-family: 'Amiri Quran', serif;
    font-size: 20px; color: var(--accent); font-weight: 700;
}
.mushaf-page-content {
    font-family: "Amiri Quran", serif;
    font-size: var(--quran-font-size);
    line-height: 2.2;
    text-align: justify;
    color: #fff;
    flex: 1;
    padding: 6px 4px;
}
.mushaf-footer-bar {
    display: flex; justify-content: space-between; align-items: center;
    padding-top: 10px; margin-top: 12px;
    border-top: 1.5px double var(--gold-glass-border);
    font-size: 12px; color: var(--muted); font-weight: 700;
}
.mushaf-page-badge {
    background: rgba(229,193,88,0.15); border: 1px solid var(--gold-glass-border);
    color: var(--accent); padding: 4px 16px; border-radius: 20px; font-size: 13px; font-weight: 900;
}
.mushaf-controls-row {
    display: grid; grid-template-columns: auto 1fr auto; gap: 10px; align-items: center; margin-top: 12px;
}
.mushaf-nav-btn {
    width: auto; padding: 12px 18px; border-radius: 16px;
    background: rgba(255,255,255,0.05); border: 1px solid var(--gold-glass-border);
    color: var(--accent); font-weight: 700; font-size: 14px; box-shadow: none;
}
.mushaf-nav-btn:hover { background: var(--accent); color: #060913; }
.mushaf-jump-bar {
    display: flex; gap: 6px; align-items: center; justify-content: center;
}
.mushaf-jump-bar input, .mushaf-jump-bar select {
    background: rgba(0,0,0,0.4); border: 1px solid var(--glass-border);
    color: #fff; border-radius: 12px; padding: 9px 10px; font-family: inherit;
    font-size: 13px; text-align: center; outline: none;
}

/* شريط أدوات القارئ والمصحف (الخط والورق والتلاوة المتصلة) */
.quran-toolbar {
    display: flex; flex-wrap: wrap; gap: 8px; justify-content: space-between; align-items: center;
    background: rgba(0,0,0,0.3); border: 1px solid var(--glass-border);
    border-radius: 16px; padding: 10px 12px; margin-bottom: 14px;
}
.q-tool-group { display: flex; gap: 6px; align-items: center; }
.q-mini-btn {
    width: auto; padding: 7px 12px; border-radius: 10px; font-size: 12px;
    background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border);
    color: #e2e8f0; box-shadow: none; font-weight: 700;
}
.q-mini-btn.active { background: var(--accent); color: #060913; border-color: transparent; }

/* --- النوافذ المنبثقة (Modals) الزجاجية الفاخرة --- */
.modal.q-modal { position: fixed; inset: 0; background: rgba(4, 7, 13, 0.72); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); display: none; align-items: flex-end; justify-content: center; z-index: 12000; padding: 15px; }
.modal.q-modal .sheet { width: 100%; max-width: 480px; max-height: 90vh; overflow-y: auto; background: rgba(15, 23, 42, 0.95); border: 1px solid var(--gold-glass-border); border-radius: 28px 28px 24px 24px; padding: 22px; box-shadow: 0 -20px 50px rgba(0,0,0,0.5); animation: fadeInUp 0.4s cubic-bezier(0.25, 1, 0.5, 1); text-align: right;}
.modal.q-modal .shead { display: flex; align-items: center; justify-content: space-between; margin-bottom: 15px; }
.modal.q-modal .stitle { color: var(--accent); font-weight: 700; font-size: 18px; margin: 0; }
.modal.q-modal .pill { font-size: 12px; padding: 4px 12px; border-radius: 20px; border: 1px solid var(--glass-border); color: var(--muted); }
.modal.q-modal .ayahBox { border: 1px solid var(--glass-border); border-radius: 20px; padding: 22px; background: rgba(0,0,0,0.2); margin-bottom: 15px; }
.modal.q-modal .ayahTxt { font-family: "Amiri Quran", serif; font-size: 24px; line-height: 1.9; text-align: center; color: #fff; }
.modal.q-modal .chip { width: auto; padding: 10px 18px; border-radius: 20px; border: 1px solid var(--glass-border); background: rgba(255,255,255,0.03); color: #cbd5e1; font-weight: 700; font-size: 13px; cursor: pointer; white-space: nowrap; outline: none; box-shadow: none; }
.modal.q-modal .chip.active { background: var(--accent); color: #060913; border-color: transparent; }
.modal.q-modal .reciters { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 10px; margin-bottom: 15px; scrollbar-width: none; direction: rtl;}
.modal.q-modal .playBtn { width: 74px; height: 74px; border-radius: 50%; display: grid; place-items: center; cursor: pointer; background: var(--accent); color: #060913; font-size: 26px; margin: 10px auto; box-shadow: 0 8px 20px var(--accent-glow); }
.modal.q-modal .controls { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 20px; }
.modal.q-modal .btn { padding: 14px; border-radius: 14px; border: 1px solid var(--glass-border); background: rgba(255,255,255,0.04); color: var(--accent); font-weight: 700; cursor: pointer; font-family: inherit; font-size: 14px; box-shadow: none; }
.modal.q-modal .btn.gold { background: var(--accent); color: #060913; border-color: transparent; }
.modal.q-modal .audioBar { display: none; align-items: center; gap: 12px; margin-top: 15px; padding: 12px; border-radius: 14px; background: rgba(0,0,0,0.3); border: 1px solid var(--glass-border); }
.modal.q-modal .bar { flex: 1; height: 6px; background: rgba(255,255,255,0.1); border-radius: 10px; overflow: hidden; }
.modal.q-modal .fill { height: 100%; width: 0; background: var(--accent); }
.modal.q-modal .time { font-size: 12px; color: var(--muted); min-width: 50px; text-align: center; }

.modal.q-modal .tafBody { border: 1px solid var(--glass-border); border-radius: 20px; padding: 18px; background: rgba(0,0,0,0.2); line-height: 1.8; font-size: 15px; color: #e2e8f0; }
.modal.q-modal .tafHead { color: var(--accent); font-weight: 700; margin-bottom: 8px; }

/* --- استايلات الميزات الـ 20 الإضافية --- */
.mood-chips-wrap {
    display: flex; gap: 8px; overflow-x: auto; padding-bottom: 8px; scrollbar-width: none;
}
.mood-chips-wrap::-webkit-scrollbar { display: none; }
.mood-chip {
    width: auto; padding: 9px 16px; border-radius: 20px; font-size: 13px; font-weight: 700;
    background: rgba(255,255,255,0.04); border: 1px solid var(--glass-border);
    color: #fff; white-space: nowrap; cursor: pointer; box-shadow: none;
}
.mood-chip.active, .mood-chip:hover {
    background: rgba(229,193,88,0.18); border-color: var(--accent); color: var(--accent);
}
.mood-result-box {
    margin-top: 12px; padding: 16px; border-radius: 18px;
    background: rgba(0,0,0,0.3); border: 1px solid var(--gold-glass-border);
    text-align: center; animation: fadeInUp 0.35s ease;
}

.features-subnav {
    display: flex; gap: 8px; overflow-x: auto; padding: 4px 2px 14px; scrollbar-width: none;
}
.features-subnav::-webkit-scrollbar { display: none; }
.feat-tab {
    width: auto; padding: 10px 16px; border-radius: 16px; font-size: 13px; font-weight: 700;
    background: rgba(255,255,255,0.04); border: 1px solid var(--glass-border);
    color: #cbd5e1; white-space: nowrap; cursor: pointer; box-shadow: none;
}
.feat-tab.active {
    background: linear-gradient(135deg, var(--accent), var(--accent-dark));
    color: #060913; border-color: transparent; box-shadow: 0 6px 18px var(--accent-glow);
}
.feat-panel { display: none; animation: fadeInUp 0.4s ease; }
.feat-panel.active { display: block; }

.stat-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 12px 0; }
.stat-mini-card {
    background: rgba(0,0,0,0.28); border: 1px solid var(--glass-border);
    border-radius: 18px; padding: 14px; text-align: center;
}
.stat-mini-card .val { font-size: 22px; font-weight: 900; color: var(--accent); display: block; }
.stat-mini-card .lbl { font-size: 12px; color: var(--muted); }

.quiz-option-btn {
    background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border);
    color: #fff; text-align: right; justify-content: flex-start;
    padding: 14px 18px; margin-bottom: 10px; border-radius: 16px; box-shadow: none;
}
.quiz-option-btn.correct { background: rgba(46, 213, 115, 0.2); border-color: #2ed573; color: #2ed573; }
.quiz-option-btn.wrong { background: rgba(255, 82, 82, 0.2); border-color: #ff5252; color: #ff5252; }

/* الـ Animations الافتراضية للتبديل والظهور */
.page { display: none; animation: fadeInUp 0.5s cubic-bezier(0.25, 1, 0.5, 1) forwards; }
.active-page { display: block; }

@keyframes fadeInUp {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
}
@keyframes fadeInDown {
    from { opacity: 0; transform: translateY(-24px); }
    to { opacity: 1; transform: translateY(0); }
}

#asmaa-container::-webkit-scrollbar { width: 4px; }
#asmaa-container::-webkit-scrollbar-track { background: rgba(255, 255, 255, 0.02); border-radius: 10px; }
#asmaa-container::-webkit-scrollbar-thumb { background: rgba(229, 193, 88, 0.3); border-radius: 10px; }
#asmaa-container::-webkit-scrollbar-thumb:hover { background: var(--accent); }
</style>
