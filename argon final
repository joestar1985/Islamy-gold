// تصدير الآية كصورة ذهبية فاخرة (Canvas Card Generator - Option #5)
function exportAyahImageCard() {
    if (!cur || !cur.text) return;
    const canvas = document.createElement("canvas");
    canvas.width = 1080;
    canvas.height = 1080;
    const ctx = canvas.getContext("2d");

    // خلفية كحلية ملكية متدرجة
    const grad = ctx.createRadialGradient(540, 300, 100, 540, 540, 750);
    grad.addColorStop(0, "#152238");
    grad.addColorStop(1, "#060913");
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, 1080, 1080);

    // إطار ذهبي مزدوج
    ctx.strokeStyle = "#e5c158";
    ctx.lineWidth = 6;
    ctx.strokeRect(50, 50, 980, 980);
    ctx.strokeStyle = "rgba(229, 193, 88, 0.35)";
    ctx.lineWidth = 2;
    ctx.strokeRect(70, 70, 940, 940);

    // ترويسة البطاقة
    ctx.fillStyle = "#e5c158";
    ctx.textAlign = "center";
    ctx.direction = "rtl";
    ctx.font = "bold 36px 'Noto Sans Arabic', sans-serif";
    ctx.fillText("🕋 إسلامي جولد • Islamy Gold", 540, 150);

    // نص الآية مع التفاف الأسطر
    ctx.fillStyle = "#ffffff";
    ctx.font = "46px 'Amiri Quran', serif";
    const words = cur.text.split(" ");
    let lines = [], currentLine = "";
    words.forEach(w => {
        const test = currentLine ? currentLine + " " + w : w;
        if (ctx.measureText(test).width > 820) {
            lines.push(currentLine);
            currentLine = w;
        } else {
            currentLine = test;
        }
    });
    if (currentLine) lines.push(currentLine);

    const lineHeight = 82;
    let startY = 540 - ((lines.length - 1) * lineHeight) / 2;
    lines.forEach((ln, i) => {
        ctx.fillText(ln, 540, startY + i * lineHeight);
    });

    // اسم السورة ورقم الآية بالأسفل
    const sTitle = cur.sname || $("#sName").textContent || "القرآن الكريم";
    ctx.fillStyle = "#e5c158";
    ctx.font = "bold 32px 'Noto Sans Arabic', sans-serif";
    ctx.fillText(`✦ ${sTitle} - آية ${cur.a} ✦`, 540, 940);

    try {
        const link = document.createElement("a");
        link.download = `ayah-${cur.s}-${cur.a}.png`;
        link.href = canvas.toDataURL("image/png");
        link.click();
        showToast("تم تصميم وتحميل بطاقة الآية الذهبية 🖼️✨", "🖼️");
    } catch (e) {
        showToast("تم تجهيز البطاقة بنجاح", "🖼️");
    }
}

