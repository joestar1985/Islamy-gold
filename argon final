function normalizeSearch(str) {
    return (str || "")
        .toLowerCase()
        .replace(/[\u0610-\u061A\u064B-\u065F\u0670\u06D6-\u06ED\u0640]/g, "")
        .replace(/[أإآٱ]/g, "ا")
        .replace(/ة/g, "ه")
        .replace(/[ىي]/g, "ي")
        .replace(/ؤ/g, "و")
        .replace(/ئ/g, "ي")
        .replace(/^سوره\s+/, "")
        .replace(/\s+/g, " ")
        .trim();
}

function renderRadioList(q) {
    let hP = "";
    const qNorm = normalizeSearch(q);
    
    const filtered = radioSurahs.filter(s => {
        const nameAr = normalizeSearch(s.name);
        const nameEn = s.englishName.toLowerCase();
        return nameAr.includes(qNorm) || nameEn.includes(qNorm) || String(s.number) === qNorm;
    });

    filtered.forEach(s => {
        const isPlayingThis = (currentRadioNum === s.number);
        
        hP += `
        <div class="surah-item ${isPlayingThis ? 'playing-active' : ''}" onclick="playRadioSurah(${s.number}, '${s.name}')">
            <span style="font-weight:700;">${s.number}. ${s.name}</span>
            <span style="font-size:12px; opacity:0.7;">${s.numberOfAyahs} آية</span>
        </div>`;
    });
    document.getElementById('audioSurahList').innerHTML = hP || "<div style='text-align:center;padding:20px;opacity:0.5;'>لا توجد نتائج مطابقة</div>";
}

function playRadioSurah(num, name) {
