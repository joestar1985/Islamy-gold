// حساب أوقات الشروق والضحى والثلث الأخير من الليل (Option #16)
function calculateNawafilTimes() {
    const toMins = t => { const p = t.split(":"); return parseInt(p[0])*60 + parseInt(p[1]); };
    const toStr = m => {
        m = ((m % 1440) + 1440) % 1440;
        return String(Math.floor(m/60)).padStart(2,'0') + ":" + String(Math.floor(m%60)).padStart(2,'0');
    };
    const fajrM = toMins(prayerTimesToday.fajr);
    const sunriseM = prayerTimesToday.sunrise ? toMins(prayerTimesToday.sunrise) : fajrM + 82;
    const duhaM = sunriseM + 20;
    const maghribM = toMins(prayerTimesToday.maghrib);
    let nightLen = (fajrM + 1440) - maghribM;
    let lastThirdM = maghribM + Math.round((nightLen * 2) / 3);

    const srEl = document.getElementById("time-sunrise");
    const dhEl = document.getElementById("time-duha");
    const ltEl = document.getElementById("time-lastthird");
    if (srEl) srEl.textContent = toStr(sunriseM);
    if (dhEl) dhEl.textContent = toStr(duhaM);
    if (ltEl) ltEl.textContent = toStr(lastThirdM);
}

