    const nisab = 85 * gPrice;
    const goldValue = (g24 * gPrice) + (g21 * (21 / 24) * gPrice);
    const totalWealth = cash + goldValue;

    document.getElementById("zk-nisab-val").textContent = nisab.toLocaleString("ar-EG");
    const dueEl = document.getElementById("zk-due-amount");
    const noteEl = document.getElementById("zk-status-note");

    if (totalWealth >= nisab && nisab > 0) {
        const zakat = totalWealth * 0.025;
        dueEl.textContent = `الزكاة الواجبة (2.5%): ${zakat.toLocaleString("ar-EG", {maximumFractionDigits: 2})}`;
        noteEl.textContent = "✅ بلغ مالك النصاب الشرعي، تجب فيه الزكاة إذا حال عليه الحول الهجري.";
