function initCompass() {
    if (typeof DeviceOrientationEvent !== 'undefined' && typeof DeviceOrientationEvent.requestPermission === 'function') {
        DeviceOrientationEvent.requestPermission().then(state => {
            if(state === 'granted') {
                window.addEventListener('deviceorientation', handleOrientation, true);
                showToast("تم تفعيل مستشعر البوصلة بنجاح 🧭", "🕋");
            } else {
                showToast("يرجى السماح بصلاحية مستشعر الاتجاه لتشغيل البوصلة.", "⚠️");
            }
        }).catch(console.error);
    } else {
        window.addEventListener('deviceorientationabsolute', handleOrientation, true);
        window.addEventListener('deviceorientation', handleOrientation, true);
        showToast("قم بتدوير الهاتف في شكل رقم 8 للمعايرة وتوجيه السهم نحو الكعبة 🕋", "🧭");
    }
}

function handleOrientation(e) {
    let compass = 0;
    if (e.webkitCompassHeading) {
        compass = e.webkitCompassHeading; 
    } else if (e.absolute && e.alpha !== null) {
        compass = 360 - e.alpha; 
    } else if (e.alpha !== null) {
        compass = 360 - e.alpha; 
    }
    
    let finalAngle = userQiblaAngle - compass;
    const arrow = document.getElementById('qArrow');
    if (!arrow) return;
    arrow.style.transform = `translate(-50%, -100%) rotate(${finalAngle}deg)`;
    
    let diff = Math.abs((finalAngle % 360 + 360) % 360);
    if (diff > 180) diff = 360 - diff;
    
    if (diff < 10) {
        arrow.style.background = 'linear-gradient(to top, transparent 10%, #2ed573 90%)';
        arrow.querySelector('.arrow-head').style.borderBottomColor = '#2ed573';
        if (navigator.vibrate && diff < 3 && !window.vibQibla) {
            navigator.vibrate(50);
            window.vibQibla = true;
        } else if (diff >= 3) {
            window.vibQibla = false;
        }
    } else {
        arrow.style.background = 'linear-gradient(to top, transparent 10%, var(--accent) 90%)';
        arrow.querySelector('.arrow-head').style.borderBottomColor = 'var(--accent)';
    }
}

