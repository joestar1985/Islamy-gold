    { title: "الحديث الأول: الأعمال بالنيات", text: "عَنْ أَمِيرِ الْمُؤْمِنِينَ أَبِي حَفْصٍ عُمَرَ بْنِ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ قَالَ: سَمِعْتُ رَسُولَ اللَّهِ ﷺ يَقُولُ: «إِنَّمَا الْأَعْمَالُ بِالنِّيَّاتِ، وَإِنَّمَا لِكُلِّ امْرِئٍ مَا نَوَى...» رواه البخاري ومسلم.", exp: "أصل عظيم من أصول الإسلام؛ مدار قبول الأعمال ومضاعفة الأجور على إخلاص النية لله تعالى." },
    { title: "الحديث الثاني: مراتب الدين (الإسلام والإيمان والإحسان)", text: "عَنْ عُمَرَ رَضِيَ اللهُ عَنْهُ فِي حَدِيثِ جِبْرِيلَ قَالَ ﷺ: «الْإِحْسَانُ أَنْ تَعْبُدَ اللَّهَ كَأَنَّكَ تَرَاهُ، فَإِنْ لَمْ تَكُنْ تَرَاهُ فَإِنَّهُ يَرَاكَ» رواه مسلم.", exp: "يجمع أركان الإسلام الخمسة وأركان الإيمان الستة ومقام المراقبة والإحسان." },
    { title: "الحديث السادس: الحلال بيّن والحرام بيّن", text: "قَالَ رَسُولُ اللَّهِ ﷺ: «إِنَّ الْحَلَالَ بَيِّنٌ، وَإِنَّ الْحَرَامَ بَيِّنٌ، وَبَيْنَهُمَا مُشْتَبِهَاتٌ لَا يَعْلَمُهُنَّ كَثِيرٌ مِنَ النَّاسِ، فَمَنِ اتَّقَى الشُّبُهَاتِ فَقَدِ اسْتَبْرَأَ لِدِينِهِ وَعِرْضِهِ... أَلَا وَإِنَّ فِي الْجَسَدِ مُضْغَةً إِذَا صَلَحَتْ صَلَحَ الْجَسَدُ كُلُّهُ، أَلَا وَهِيَ الْقَلْبُ».", exp: "دعوة للورع وترك المشتبهات وإصلاح القلب لأنه ملك الجوارح." },
    { title: "الحديث الثاني عشر: من حسن إسلام المرء", text: "عَنْ أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ قَالَ: قَالَ رَسُولُ اللَّهِ ﷺ: «مِنْ حُسْنِ إِسْلَامِ الْمَرْءِ تَرْكُهُ مَا لَا يَعْنِيهِ» حديث حسن رواه الترمذي.", exp: "حفظ اللسان والوقت عما لا فائدة فيه في الدنيا والآخرة." },
    { title: "الحديث الثامن عشر: اتق الله حيثما كنت", text: "عَنْ أَبِي ذَرٍّ وَمُعَاذِ بْنِ جَبَلٍ رَضِيَ اللهُ عَنْهُمَا عَنْ رَسُولِ اللَّهِ ﷺ قَالَ: «اتَّقِ اللَّهَ حَيْثُمَا كُنْتَ، وَأَتْبِعِ السَّيِّئَةَ الْحَسَنَةَ تَمْحُهَا، وَخَالِقِ النَّاسَ بِخُلُقٍ حَسَنٍ».", exp: "وصية جامعة لحق الله بالتقوى، وحق النفس بالمبادرة للتوبة، وحق الخلق بحسن المعاملة." },
    { title: "الحديث التاسع عشر: احفظ الله يحفظك", text: "عَنِ ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا قَالَ: كُنْتُ خَلْفَ رَسُولِ اللَّهِ ﷺ يَوْمًا فَقَالَ: «يَا غُلَامُ إِنِّي أُعَلِّمُكَ كَلِمَاتٍ: احْفَظِ اللَّهَ يَحْفَظْكَ، احْفَظِ اللَّهَ تَجِدْهُ تُجَاهَكَ، إِذَا سَأَلْتَ فَاسْأَلِ اللَّهَ، وَإِذَا اسْتَعَنْتَ فَاسْتَعِنْ بِاللَّهِ».", exp: "ترسيخ التوكل على الله وحده واللجوء إليه في كل صغيرة وكبيرة." },
    { title: "الحديث الخامس والعشرون: فضل الذكر والصدقة", text: "قَالَ ﷺ: «كُلُّ تَسْبِيحَةٍ صَدَقَةٌ، وَكُلُّ تَكْبِيرَةٍ صَدَقَةٌ، وَكُلُّ تَحْمِيدَةٍ صَدَقَةٌ، وَكُلُّ تَهْلِيلَةٍ صَدَقَةٌ، وَأَمْرٌ بِالْمَعْرُوفِ صَدَقَةٌ، وَنَهْيٌ عَنِ الْمُنْكَرِ صَدَقَةٌ» رواه مسلم.", exp: "أبواب الخير والصدقات في الإسلام واسعة تشمل كل ذكر ونفع للناس." }
];
function renderHadiths(q) {
    const query = (q || "").trim();
    const list = nawawiHadiths.filter(h => h.title.includes(query) || h.text.includes(query) || h.exp.includes(query));
    const box = document.getElementById("hadith-list-container");
    if (!box) return;
    box.innerHTML = list.map(h => `
        <div class="azkar-item" style="cursor:default;">
            <div style="color:var(--accent); font-weight:700; margin-bottom:8px;">✦ ${h.title}</div>
            <div class="azkar-text" style="font-size:20px;">${h.text}</div>
            <div style="font-size:13px; color:#cbd5e1; border-top:1px dashed var(--glass-border); padding-top:8px; margin-top:8px;">💡 <strong>الفائدة:</strong> ${h.exp}</div>
            <button class="q-mini-btn" style="margin-top:10px;" onclick="safeCopyText('${h.title}\\n${h.text}', 'تم نسخ الحديث النبوي الشريف 📋')">📋 نسخ الحديث</button>
        </div>
    `).join("");
}

// 7. المسابقة الإسلامية والقرآنية (Option #18)
const quizQuestions = [
    { cat: "علوم القرآن", q: "ما هي السورة التي تعدل ثلث القرآن الكريم؟", opts: ["سورة الإخلاص", "سورة الفاتحة", "سورة الملك", "سورة يس"], ans: 0 },
    { cat: "علوم القرآن", q: "ما هي السورة الوحيدة في القرآن الكريم التي تخلو من البسملة في أولها؟", opts: ["سورة التوبة", "سورة الأنفال", "سورة الحج", "سورة النمل"], ans: 0 },
    { cat: "السيرة النبوية", q: "في أي غزوة جُرح النبي ﷺ وكُسرت رباعيته؟", opts: ["غزوة بدر", "غزوة أُحد", "غزوة الخندق", "غزوة حنين"], ans: 1 },
    { cat: "علوم القرآن", q: "كم عدد صفحات المصحف الشريف (مصحف المدينة النبوية)؟", opts: ["500 صفحة", "600 صفحة", "604 صفحات", "620 صفحة"], ans: 2 },
    { cat: "الفقه والعبادات", q: "ما هو نصاب زكاة الذهب الخالص (عيار 24) بالجرام؟", opts: ["50 جراماً", "85 جراماً", "100 جرام", "200 جرام"], ans: 1 },
    { cat: "الأنبياء في القرآن", q: "من هو النبي الذي التهمه الحوت فدعا: (لا إله إلا أنت سبحانك إني كنت من الظالمين)؟", opts: ["أيوب عليه السلام", "يونس عليه السلام", "إدريس عليه السلام", "إلياس عليه السلام"], ans: 1 }
];
let quizIdx = 0, quizScore = safeGetStorage('islamy_quiz_score', 0), quizStreak = 0, quizAnswered = false;
function initIslamicQuiz() {
    document.getElementById("quiz-score").textContent = quizScore;
    loadQuizQuestion();
}
function loadQuizQuestion() {
    quizAnswered = false;
    const item = quizQuestions[quizIdx % quizQuestions.length];
    document.getElementById("quiz-q-cat").textContent = `✦ ${item.cat}`;
    document.getElementById("quiz-q-text").textContent = item.q;
    document.getElementById("quiz-feedback").style.display = "none";
    document.getElementById("quiz-options").innerHTML = item.opts.map((opt, i) => `
        <button class="quiz-option-btn" onclick="answerQuiz(${i}, this)">${opt}</button>
    `).join("");
}
function answerQuiz(choiceIdx, btnEl) {
    if (quizAnswered) return;
    quizAnswered = true;
    const item = quizQuestions[quizIdx % quizQuestions.length];
    const btns = document.querySelectorAll("#quiz-options .quiz-option-btn");
    const fb = document.getElementById("quiz-feedback");
    fb.style.display = "block";
    if (choiceIdx === item.ans) {
        btnEl.classList.add("correct");
        quizScore += 10;
        quizStreak++;
        safeSetStorage('islamy_quiz_score', quizScore);
        fb.textContent = "✅ إجابة صحيحة! بارك الله في علمك (+10 نقاط)";
        fb.style.color = "#2ed573";
    } else {
        btnEl.classList.add("wrong");
        if (btns[item.ans]) btns[item.ans].classList.add("correct");
        quizStreak = 0;
        fb.textContent = `❌ الإجابة الصحيحة هي: ${item.opts[item.ans]}`;
        fb.style.color = "#ff5252";
    }
    document.getElementById("quiz-score").textContent = quizScore;
    document.getElementById("quiz-streak").textContent = quizStreak;
}
function nextQuizQuestion() {
    quizIdx++;
    loadQuizQuestion();
}

// 8. متتبع الصيام والمناسبات الإسلامية (Option #14 & #15)
