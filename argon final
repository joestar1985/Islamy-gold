// صوت تقليب الصفحة الورقية عبر Web Audio API
function playPageFlipSound() {
    if (!sebhaSoundEnabled) return;
    try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const bufferSize = ctx.sampleRate * 0.09;
        const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
            data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (ctx.sampleRate * 0.025));
        }
        const noise = ctx.createBufferSource();
        noise.buffer = buffer;
        const filter = ctx.createBiquadFilter();
        filter.type = "bandpass";
        filter.frequency.value = 1100;
        const gain = ctx.createGain();
        gain.gain.value = 0.14;
        noise.connect(filter);
        filter.connect(gain);
        gain.connect(ctx.destination);
        noise.start();
    } catch (e) {}
}

async function loadMushafPage(pageNum, flipDirection = 0) {
    pageNum = Math.max(1, Math.min(604, parseInt(pageNum) || 1));
    currentMushafPage = pageNum;
    safeSetStorage('islamy_mushaf_page', currentMushafPage);
    const inp = document.getElementById("mushaf-page-input");
    if (inp) inp.value = currentMushafPage;

    const card = document.getElementById("mushafPageCard");
    if (card && flipDirection !== 0) {
        card.classList.remove("flipping-next", "flipping-prev");
        void card.offsetWidth; // trigger reflow
        card.classList.add(flipDirection > 0 ? "flipping-next" : "flipping-prev");
        playPageFlipSound();
    }

    const contentEl = document.getElementById("mp-content");
    const pageBadge = document.getElementById("mp-page-num");
    if (pageBadge) pageBadge.textContent = `صفحة ${pageNum.toLocaleString("ar-EG")}`;

    try {
        let pageData = mushafPageCache[pageNum];
        if (!pageData) {
            contentEl.innerHTML = `<div style="text-align:center; padding:80px 10px; color:var(--muted);">📖 جاري فتح صفحة ${pageNum.toLocaleString("ar-EG")}...</div>`;
            const res = await fetch(`https://api.alquran.cloud/v1/page/${pageNum}/quran-uthmani`);
            const json = await res.json();
            pageData = json.data;
            mushafPageCache[pageNum] = pageData;
        }
        renderMushafPageContent(pageData);
    } catch (e) {
        contentEl.innerHTML = `<div style="text-align:center; padding:50px 10px; color:var(--muted);">تعذر تحميل الصفحة. تأكد من اتصالك بالإنترنت.</div>`;
    }
}

function renderMushafPageContent(pageData) {
    const ayahs = pageData.ayahs || [];
    if (!ayahs.length) return;
    const first = ayahs[0];
    const juzNum = first.juz || 1;
    const hizbNum = Math.ceil((first.hizbQuarter || 1) / 4);
    document.getElementById("mp-surah-name").textContent = first.surah ? first.surah.name : "";
    document.getElementById("mp-juz-info").textContent = `الجزء ${juzNum.toLocaleString("ar-EG")} • الحزب ${hizbNum.toLocaleString("ar-EG")}`;

    let html = "";
    let lastSurahNum = null;
    ayahs.forEach(a => {
        const sNum = a.surah.number;
        const sName = a.surah.name;
        if (sNum !== lastSurahNum) {
            if (a.numberInSurah === 1) {
                html += `<div class="mushaf-surah-banner">✦ ${sName} ✦</div>`;
                if (sNum !== 1 && sNum !== 9) {
                    html += `<div class="basmala" style="font-size:23px; margin:8px 0 12px;">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</div>`;
                }
            }
            lastSurahNum = sNum;
        }
        const an = a.numberInSurah.toLocaleString("ar-EG");
        const isB = (bookmark && bookmark.s === sNum && bookmark.a === a.numberInSurah) ? ' bookmarked' : '';
        html += `<span class="ayah${isB}" data-s="${sNum}" data-a="${a.numberInSurah}" data-sname="${sName}" data-t="${a.text.replace(/"/g,"&quot;")}" onclick="pick(this)">${a.text} <span class="anum">${an}</span></span> `;
    });
    document.getElementById("mp-content").innerHTML = html;
}

