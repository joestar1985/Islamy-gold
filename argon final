function logFastingDay(type) {
    fastingDays++;
    fastingToday = true;
    safeSetStorage('islamy_fasting_days', fastingDays);
    document.getElementById("fasting-total-days").textContent = fastingDays;
    document.getElementById("fasting-today-status").textContent = `صائم (${type})`;
    showToast(`تقبل الله صيامك! बाعَد الله وجهك عن النار سبعين خريفاً 🌙`, "🌟");
}

// 9. بطاقة الإنجاز الإيماني اليومي (Option #19)
let worshipState = safeGetStorage('islamy_worship_v1', { azkarDone: false, sadaqahDone: false, duhaDone: false, witrDone: false });
function renderDailyScorecard() {
    const prayersDone = Object.values(prayerState).filter(Boolean).length;
    const sunnahDone = Object.values(sunnahState).filter(Boolean).length;
    const totalPoints = (prayersDone * 12) + (sunnahDone * 4) + (worshipState.azkarDone ? 8 : 0) + (worshipState.sadaqahDone ? 8 : 0);
    const pct = Math.min(100, totalPoints);
    const sumBox = document.getElementById("daily-score-summary");
    if (sumBox) {
        sumBox.innerHTML = `
            <div style="font-size:32px; font-weight:900; color:var(--accent);">${pct}%</div>
            <div style="font-size:14px; color:#fff; font-weight:700; margin-top:4px;">مؤشر الهمة الإيمانية اليوم</div>
            <div style="font-size:12px; color:var(--muted); margin-top:6px;">الصلوات المفروضة: ${prayersDone}/5 • السنن الرواتب: ${sunnahDone}/6 • التسبيحات: ${sebhaCount}</div>
        `;
    }
}

// 10. دفتر الخواطر والأدعية الخاصة (Option #22)
let journalEntries = safeGetStorage('islamy_journal_v1', [
    { text: "اللهم يا مقلب القلوب ثبت قلبي على دينك، وارزقني حسن الخاتمة والفردوس الأعلى.", date: "دعاء محفوظ" }
]);
function renderJournalEntries() {
    const box = document.getElementById("journal-entries-list");
    if (!box) return;
    box.innerHTML = journalEntries.map((item, idx) => `
        <div style="background:rgba(255,255,255,0.02); border:1px solid var(--glass-border); border-radius:16px; padding:14px; margin-bottom:8px; display:flex; justify-content:space-between; align-items:center; gap:10px;">
            <div>
                <div style="font-size:14px; color:#fff; line-height:1.6;">${item.text}</div>
                <small style="font-size:11px; color:var(--accent);">${item.date}</small>
            </div>
            <button class="azkar-reset-btn" onclick="deleteJournalEntry(${idx})">🗑️</button>
        </div>
    `).join("");
}
function addJournalEntry() {
    const inp = document.getElementById("journal-input");
    const txt = (inp?.value || "").trim();
    if (!txt) {
        showToast("اكتب دعاءك أو خاطرتك أولاً للحفظ", "📝");
        return;
    }
    const d = new Date().toLocaleDateString("ar-EG");
    journalEntries.unshift({ text: txt, date: d });
    safeSetStorage('islamy_journal_v1', journalEntries);
    inp.value = "";
    renderJournalEntries();
    showToast("تم حفظ الدعاء في دفترك الإيماني ✨", "📝");
}
function deleteJournalEntry(idx) {
    journalEntries.splice(idx, 1);
    safeSetStorage('islamy_journal_v1', journalEntries);
    renderJournalEntries();
}

