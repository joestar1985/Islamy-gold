function startPrayerCountdown() {
    if(countdownInterval) clearInterval(countdownInterval);
    
    function checkTime() {
        const now = new Date();
        const currentMinutes = now.getHours() * 60 + now.getMinutes();
        
        const list = [
            { name: "الفجر", id: "fajr", time: prayerTimesToday.fajr },
            { name: "الظهر", id: "dhuhr", time: prayerTimesToday.dhuhr },
            { name: "العصر", id: "asr", time: prayerTimesToday.asr },
            { name: "المغرب", id: "maghrib", time: prayerTimesToday.maghrib },
            { name: "العشاء", id: "isha", time: prayerTimesToday.isha }
        ];
        
        let next = null;
        let activeId = "isha"; 
        
        document.querySelectorAll('.prayer-row-item').forEach(el => el.classList.remove('current-active'));
        
        for (let i = 0; i < list.length; i++) {
            const parts = list[i].time.split(":");
            const pMinutes = parseInt(parts[0]) * 60 + parseInt(parts[1]);
            
            if (pMinutes > currentMinutes) {
                next = list[i];
                if (i > 0) activeId = list[i-1].id;
                break;
            }
        }
        
        if (!next) {
            next = list[0]; 
            activeId = "isha";
        }
        
        const activeRow = document.getElementById(`row-${activeId}`);
        if(activeRow) activeRow.classList.add('current-active');
        
        const nextTitleEl = document.getElementById("next-prayer-name");
        if(nextTitleEl) nextTitleEl.innerText = next.name;
        
        const parts = next.time.split(":");
        let target = new Date();
        target.setHours(parseInt(parts[0]), parseInt(parts[1]), 0);
        if (target < now) {
            target.setDate(target.getDate() + 1);
        }
        
        const diff = target - now;
        const diffHrs = Math.floor(diff / 3600000);
        const diffMins = Math.floor((diff % 3600000) / 60000);
        
        const timerEl = document.getElementById("prayer-countdown-timer");
        if(timerEl) {
            timerEl.innerText = String(diffHrs).padStart(2, '0') + ":" + String(diffMins).padStart(2, '0');
        }
    }
    
    checkTime();
    countdownInterval = setInterval(checkTime, 30000); 
}

function calculateQibla(lat, lng) {
    const mLat = 21.422487 * Math.PI / 180;
    const mLng = 39.826206 * Math.PI / 180;
    const uLat = lat * Math.PI / 180;
    const uLng = lng * Math.PI / 180;
    const y = Math.sin(mLng - uLng);
    const x = Math.cos(uLat) * Math.tan(mLat) - Math.sin(uLat) * Math.cos(mLng - uLng);
    let q = Math.atan2(y, x) * 180 / Math.PI;
    return (q + 360) % 360;
}

async function fetchPrayersByCoords(lat, lng, cityLabel = "") {
    userQiblaAngle = Math.round(calculateQibla(lat, lng));
    const qDegEl = document.getElementById("qibla-deg-label");
    if (qDegEl) qDegEl.textContent = userQiblaAngle + "°";
    try {
        const res = await fetch(`https://api.aladhan.com/v1/timings/${Math.floor(Date.now()/1000)}?latitude=${lat}&longitude=${lng}&method=5`);
        const j = await res.json();
        if(j && j.data) {
            const timings = j.data.timings;
            prayerTimesToday.fajr = timings.Fajr;
            prayerTimesToday.sunrise = timings.Sunrise;
            prayerTimesToday.dhuhr = timings.Dhuhr;
            prayerTimesToday.asr = timings.Asr;
            prayerTimesToday.maghrib = timings.Maghrib;
            prayerTimesToday.isha = timings.Isha;
            
            document.getElementById("fajr").innerText = timings.Fajr;
            document.getElementById("dhuhr").innerText = timings.Dhuhr;
            document.getElementById("asr").innerText = timings.Asr;
            document.getElementById("maghrib").innerText = timings.Maghrib;
            document.getElementById("isha").innerText = timings.Isha;
            document.getElementById("h-date").innerText = j.data.date.hijri.day + " " + j.data.date.hijri.month.ar + " " + j.data.date.hijri.year;
            
            calculateNawafilTimes();
            startPrayerCountdown();
            if (cityLabel) showToast(`تمت مزامنة مواقيت الصلاة وزاوية القبلة (${userQiblaAngle}°) ✨`, "🕌");
        }
    } catch(e) {
        showToast("تعذر جلب البيانات المباشرة، تم استخدام المواقيت المحفوظة.", "⚠️");
    }
}

function getLocation() {
    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(
            pos => fetchPrayersByCoords(pos.coords.latitude, pos.coords.longitude, "موقعك الحالي"),
            () => {
                // في حال عدم تفعيل الـ GPS يتم الضبط على القاهرة افتراضياً مع إشعار لطيف
                fetchPrayersByCoords(30.0444, 31.2357, "القاهرة");
                showToast("تم ضبط المواقيت على توقيت القاهرة افتراضياً (فعّل GPS لدقة أعلى) 📍", "🕌");
            }
        );
    } else {
        fetchPrayersByCoords(30.0444, 31.2357, "القاهرة");
    }
}

